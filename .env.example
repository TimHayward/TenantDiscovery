# Copy to .env and fill in before `docker compose up`.
# All Azure values may be left empty and configured later via the
# onboarding UI (stored on the api-data volume).

# Microsoft Entra app registration (client-credentials flow)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Host port the dashboard is published on
DASHBOARD_PORT=8089

# Optional tuning
LOG_LEVEL=info
#SCAN_HISTORY_LIMIT=
#GRAPH_FETCH_TIMEOUT_MS=
#GRAPH_MAX_RETRIES=

# Only needed if you publish the API port directly and call it
# cross-origin from a browser (comma-separated origins):
#CORS_ALLOWED_ORIGINS=

# The API is unauthenticated and holds Graph credentials — it refuses to
# start on a non-loopback HOST unless you explicitly set ALLOW_REMOTE=true.
#HOST=127.0.0.1
#ALLOW_REMOTE=
