# Copy to .env and fill in before `docker compose up`.
# All Azure values may be left empty and configured later via the
# onboarding UI (stored on the api-data volume).

# Microsoft Entra app registration (client-credentials flow)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Host port the dashboard is published on
DASHBOARD_PORT=8089

# Offline demonstration mode. Set to the name of a directory under fixtures/
# (`healthy-mid-market` or `neglected-smb` ship with the repository) and the API
# serves that recorded snapshot instead of calling Microsoft Graph. No Azure
# credentials are needed, onboarding is satisfied, every API response is flagged
# as demonstration data and the dashboard shows a banner that cannot be
# dismissed. Leave it empty for normal operation.
#
# The figures a demonstration shows are fictional. Never present one as an
# assessment of a tenant.
#DEMO_MODE=neglected-smb

# Where the fixture profiles live. Only needed when the server runs somewhere
# the repository is not, such as a container: mount the fixtures and point at
# them. Left unset, the server walks up from its own location to find fixtures/.
#DEMO_FIXTURES_DIR=/fixtures

# Optional tuning
LOG_LEVEL=info
#SCAN_HISTORY_LIMIT=
#GRAPH_FETCH_TIMEOUT_MS=
#GRAPH_MAX_RETRIES=

# Concurrent collection requests allowed per host. Both default to 8. Lower
# them if the tenant still reports throttling; raise them only with evidence,
# because exceeding what the tenant tolerates makes a refresh slower, not
# faster. A value of 1 serialises collection and will make a refresh take
# considerably longer.
#GRAPH_MAX_CONCURRENCY=
#DEFENDER_MAX_CONCURRENCY=

# Only needed if you publish the API port directly and call it
# cross-origin from a browser (comma-separated origins):
#CORS_ALLOWED_ORIGINS=

# The API holds Graph credentials, so it refuses to start on a non-loopback
# HOST unless you explicitly set ALLOW_REMOTE=true.
#HOST=127.0.0.1
#ALLOW_REMOTE=

# Bearer token for the API. Only consulted when HOST is non-loopback: on
# loopback the API requires no token and the binding is the control.
#
# Leave this empty and the token generated on the first onboarding save is
# used instead; it is shown once, in that save's response, and never again.
# Set it explicitly when the server is exposed before onboarding has run
# (a container, for instance), because a non-loopback binding with no token
# configured answers 503 rather than serving data.
#
# Anyone holding this token has the same access to tenant data as the
# dashboard. Treat it as a credential.
#API_AUTH_TOKEN=
